{
  "openapi": "3.0.0",
  "info": {
    "title": "OpenDoors User API",
    "version": "1.0.0",
    "description": "API Documentation for OpenDoors User API, featuring standard JSON responses and Multipart Form capabilities."
  },
  "servers": [
    {
      "url": "..",
      "description": "Current Environment API Server"
    }
  ],
  "paths": {
    "/reels/create.php": {
      "post": {
        "summary": "Create or Update a Reel",
        "description": "Upload a new video reel for a property. If a reel already exists for the property, it replaces the existing one.",
        "tags": ["Reels"],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "uid": { "type": "string", "example": "1" },
                  "prop_id": { "type": "string", "example": "42" },
                  "video": { "type": "string", "format": "binary", "description": "Max 300MB. Formats: mp4, mov, avi, mkv, webm." },
                  "thumbnail": { "type": "string", "format": "binary", "description": "Optional. Automatically generated if omitted." }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Created — new reel",
            "content": {
              "application/json": {
                "examples": {
                  "created_ffmpeg": {
                    "summary": "New reel (ffmpeg available)",
                    "value": { "ResponseCode": "200", "Result": "true", "ResponseMsg": "Reel uploaded and processing started." }
                  },
                  "created_no_ffmpeg": {
                    "summary": "New reel (no ffmpeg — direct upload)",
                    "value": { "ResponseCode": "200", "Result": "true", "ResponseMsg": "Reel uploaded successfully ." }
                  },
                  "replaced_ffmpeg": {
                    "summary": "Existing reel replaced (ffmpeg available)",
                    "value": { "ResponseCode": "200", "Result": "true", "ResponseMsg": "Reel updated and processing started." }
                  },
                  "replaced_no_ffmpeg": {
                    "summary": "Existing reel replaced (no ffmpeg)",
                    "value": { "ResponseCode": "200", "Result": "true", "ResponseMsg": "Reel updated successfully ." }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Validation / authorisation error",
            "content": {
              "application/json": {
                "example": { "ResponseCode": "401", "Result": "false", "ResponseMsg": "Property not found or access denied." }
              }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "example": { "ResponseCode": "500", "Result": "false", "ResponseMsg": "Database error." }
              }
            }
          }
        }
      }
    },
    "/reels/update.php": {
      "post": {
        "summary": "Update an existing Reel by reel_id",
        "description": "Replace the video (and optionally thumbnail) of an existing reel. Old files are deleted from disk. The old thumbnail is preserved if a new one is not supplied.",
        "tags": ["Reels"],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["uid", "reel_id", "video"],
                "properties": {
                  "uid": { "type": "string", "example": "1" },
                  "reel_id": { "type": "string", "example": "15", "description": "ID of the reel to update." },
                  "video": { "type": "string", "format": "binary", "description": "Max 300MB. Formats: mp4, mov, avi, mkv, webm." },
                  "thumbnail": { "type": "string", "format": "binary", "description": "Optional. If omitted, the thumbnail is auto-generated from the new video via ffmpeg (or the old thumbnail is cleared if ffmpeg is unavailable)." }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "examples": {
                  "with_ffmpeg": {
                    "summary": "ffmpeg available — processing in background",
                    "value": { "ResponseCode": "200", "Result": "true", "ResponseMsg": "Reel updated and processing started." }
                  },
                  "no_ffmpeg": {
                    "summary": "No ffmpeg — direct upload",
                    "value": { "ResponseCode": "200", "Result": "true", "ResponseMsg": "Reel updated successfully ." }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Validation / authorisation error",
            "content": {
              "application/json": {
                "example": { "ResponseCode": "401", "Result": "false", "ResponseMsg": "Reel not found." }
              }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "example": { "ResponseCode": "500", "Result": "false", "ResponseMsg": "Database error." }
              }
            }
          }
        }
      }
    },
    "/reels/delete.php": {
      "post": {
        "summary": "Delete a Reel",
        "description": "Delete a reel and its associated files.",
        "tags": ["Reels"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "uid": { "type": "string", "example": "1" },
                  "reel_id": { "type": "string", "example": "15" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "example": {
                  "ResponseCode": "200",
                  "Result": "true",
                  "ResponseMsg": "Reel deleted successfully."
                }
              }
            }
          }
        }
      }
    },
    "/reels/index.php": {
      "get": {
        "summary": "List all active Reels",
        "description": "Fetches a paginated list of all active (fully processed) reels.",
        "tags": ["Reels"],
        "parameters": [
          {
            "name": "last_id",
            "in": "query",
            "schema": { "type": "integer", "default": 0 },
            "description": "Cursor for pagination (ID of the last item in previous page)."
          },
          {
            "name": "limit",
            "in": "query",
            "schema": { "type": "integer", "default": 10 }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "example": {
                  "ResponseCode": "200",
                  "Result": "true",
                  "ResponseMsg": "Reels fetched successfully.",
                  "reels": [
                    {
                      "reel_id": "15",
                      "prop_id": "42",
                      "thumbnail_path": "uploads/reels/thumbnails/thumb_6abc123.png",
                      "property_title": "Cozy Apartment",
                      "property_address": "123 Main St",
                      "property_image": "prop_image.jpg"
                    }
                  ],
                  "next_cursor": 14
                }
              }
            }
          }
        }
      }
    },
    "/reels/read.php": {
      "get": {
        "summary": "Get a specific Reel",
        "description": "Fetch details for a single reel including video_path.",
        "tags": ["Reels"],
        "parameters": [
          {
            "name": "reel_id",
            "in": "query",
            "schema": { "type": "integer" }
          },
          {
            "name": "prop_id",
            "in": "query",
            "schema": { "type": "integer" },
            "description": "Can be used instead of reel_id to fetch the reel for a property."
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "example": {
                  "ResponseCode": "200",
                  "Result": "true",
                  "ResponseMsg": "Reel fetched successfully.",
                  "reel": {
                    "reel_id": "15",
                    "prop_id": "42",
                    "video_path": "uploads/reels/videos/reel_6abc123.mp4",
                    "thumbnail_path": "uploads/reels/thumbnails/thumb_6abc123.png",
                    "reel_status": "1",
                    "property_title": "Cozy Apartment",
                    "property_address": "123 Main St",
                    "property_image": "prop_image.jpg",
                    "property_price": "1200",
                    "beds": "2",
                    "bathroom": "1"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
